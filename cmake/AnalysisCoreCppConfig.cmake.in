@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT @FETCHED_CXXOPTS@)
 find_dependency(cxxopts 3.2.0 EXACT CONFIG)
endif()

if(NOT @FETCHED_TOMLPP@)
 find_dependency(tomlplusplus 3.4.0 EXACT CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AnalysisCoreCppTargets.cmake")

check_required_components(AnalysisCoreCpp)
